# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
TRUST_PROXY=true
FORCE_HTTPS=true
PUBLIC_SITE_URL=https://realpricenolies.online

# High-Traffic Scaling & Gemini Wallet Protection
MAX_DAILY_GEMINI_CALLS=500
MAX_MINUTE_GEMINI_CALLS=30
MAX_CONCURRENT_ANALYSES=15
RATE_LIMIT_MAX_REQUESTS=12

# Optional AI Enrichment API Keys (add your real keys in .env or host secrets, never in .env.example)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Monetization / Ad Network IDs (activated only after user consent)
ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
ETHICAL_ADS_PUBLISHER=
